# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Node / npm logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# --- Next.js ---
apps/web/.next/
apps/web/out/
apps/web/build/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo
*.tsbuildinfo

# --- Turborepo ---
.turbo/

# --- Python (orchestrator) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
apps/orchestrator/.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Worker scratch space ---
workspace/
apps/orchestrator/workspace/

# --- Supabase CLI local state (regenerated by `supabase link`) ---
supabase/.temp/
supabase/.branches/
apps/web/supabase/.temp/
apps/web/supabase/.branches/

# --- Environment / secrets ---
.env
.env.*
!.env.example
!apps/*/.env.example

# --- Editors / OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Local agent / tooling config ---
.claude/settings.local.json

# --- Misc build output ---
coverage/
dist/
*.log
