# --- Environment (the single flag) ---
# "local" (default) keeps every URL below on localhost. Set APP_ENV=prod
# and every one of them switches to the real meero.im / api.meero.im domain
# in one move — see _derive_env_urls() in app/config.py. Leave the specific
# *_URL vars below BLANK to get that automatic behavior; set any one of them
# explicitly (e.g. for a staging domain) to override just that field
# regardless of APP_ENV.
APP_ENV=local

# --- Supabase (service role — NEVER ship to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- OpenAI codegen (free plan + the paid "GPT" model-selector option) ---
OPENAI_API_KEY=sk-...
# GPT-5.6 family: `gpt-5.6`/`gpt-5.6-sol` (flagship), `gpt-5.6-terra`
# (balanced), `gpt-5.6-luna` (budget). Terra is the paid-plan "GPT" pick.
OPENAI_MODEL=gpt-5.6-terra
# Cheaper model for free-plan users — the budget tier of the same family.
OPENAI_MODEL_FREE=gpt-5.6-luna

# --- Anthropic codegen + chat (Pro/Ultra) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe billing (leave blank to run without billing enabled) ---
# Create the Pro ($9.99/mo) and Ultra ($24.99/mo) recurring Prices in the
# Stripe Dashboard first, then paste their price IDs (price_...) below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
# One-time $5 Stripe Price (mode=payment, NOT recurring) for the permanent
# "buy more tokens" top-up in billing settings — grants CREDITS_TOPUP_TOKENS
# (250k) real bonus tokens, not a gating bypass.
STRIPE_PRICE_CREDITS_TOPUP=

# Blank = derive from APP_ENV (http://localhost:3000/... locally,
# https://meero.im/... in prod). Set explicitly only to override.
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

# --- App building (every plan) ---
# The web worker runs a real `next build` (static export) against the
# LLM-generated Next.js + shadcn/ui project, using a pre-vendored toolchain
# (Next, React, Tailwind, the shadcn/ui Radix primitives, lucide-react,
# @supabase/supabase-js — the generated apps' whole dependency surface)
# installed ONCE at worker-image build time (orchestrator/Dockerfile). No
# npm install ever runs per build. Default matches the Dockerfile; only
# override if running web_worker.py outside it.
APP_VENDOR_DIR=/vendor/app
# How long a real `next build` may run before it's treated as hung and failed.
BUILD_TIMEOUT_S=600

# --- Supabase connect (generated apps' backend — leave blank to run
#     without it; the button reports "isn't configured" and builds fail
#     with a clear "link Supabase" error) ---
# Register a Supabase OAuth App: supabase.com/dashboard -> your org ->
# settings -> OAuth Apps -> Add application.
# 1. Authorization callback URL must exactly match SUPABASE_OAUTH_REDIRECT_URI
#    below (an EXTERNAL dashboard setting — APP_ENV can't reach it; when you
#    flip to prod, update this OAuth App's own callback URL by hand to
#    https://api.meero.im/auth/supabase/callback).
# 2. Copy the generated Client ID + Client Secret here.
# Users then connect their OWN Supabase account in the builder; Meero
# applies each build's schema.sql to their chosen project via the real
# Management API.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Blank = derive from APP_ENV. See the dashboard note above before you
# actually flip to prod — the two must match exactly.
SUPABASE_OAUTH_REDIRECT_URI=

# --- Production release (Pro & Ultra plans; leave blank to run without it —
#     the release button reports a clear "isn't configured" error instead
#     of hanging) ---
# A real Vercel access token (vercel.com → Settings → Tokens). The deploy
# worker ships the app's real Next.js source through Vercel's REST API,
# which runs its own genuine `next build`, and polls until READY.
VERCEL_TOKEN=
# Optional: deploy into a Vercel team instead of the token's personal scope.
VERCEL_TEAM_ID=
# How long to wait for Vercel to reach READY before reporting a real failure.
DEPLOY_TIMEOUT_S=600

# --- GitHub publish (leave blank to run without it; the button reports
#     "GitHub isn't configured" instead of failing silently) ---
# A dedicated OAuth App. First publish creates a real private repo and pushes
# the initial commit; every later successful build then opens a REAL pull
# request on that repo.
#
# 1. github.com/settings/developers -> New OAuth App.
# 2. Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI
#    below (another EXTERNAL dashboard setting — update this OAuth App's own
#    callback URL by hand to https://api.meero.im/auth/github/callback when
#    you flip to prod).
# 3. Copy the generated Client ID, and generate + copy a Client Secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Blank = derive from APP_ENV. See the dashboard note above first.
GITHUB_OAUTH_REDIRECT_URI=

# --- Transactional email (leave RESEND_API_KEY blank to run without it —
#     the in-process poller just skips its pass; generated apps can still
#     create the `_meero_emails` table, rows just stay 'pending') ---
# A real Resend API key (resend.com -> API Keys) with a verified sending
# domain (resend.com -> Domains). An in-process background poller
# (app/main.py's _start_email_poller) reads real pending rows out of every
# Supabase-linked project's own `_meero_emails` table and sends them
# through Resend's REST API — see app/email_send.py.
RESEND_API_KEY=
# Must be on the verified domain above, e.g. "Meero Apps <apps@meero.im>".
RESEND_FROM_EMAIL=Meero Apps <apps@meero.im>
EMAIL_POLL_INTERVAL_S=30
# Real per-project hourly cap, counted from actual sent rows — the backstop
# against a compromised/malicious end-user of a GENERATED app burning its
# owner's Resend quota.
EMAIL_RATE_LIMIT_PER_PROJECT_PER_HOUR=50

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
ARTIFACTS_BUCKET=artifacts
# Storage bucket (created by 00011_expo_platform.sql) that web_worker.py
# uploads the live app bundle to. NOT iframed directly — Supabase Storage
# forces text/html down to text/plain and blocks script execution on every
# publicly served object, so the app could never run if the browser loaded
# it straight from there. The orchestrator's own /preview route
# (app/main.py) downloads from here and re-serves with real headers instead.
PREVIEWS_BUCKET=previews
WORKSPACE_DIR=./workspace
# Where the browser lives — used to redirect back after the GitHub OAuth
# flow. Blank = derive from APP_ENV.
FRONTEND_URL=
# This orchestrator's own PUBLIC base URL, as reachable from a user's browser
# — same value as the frontend's NEXT_PUBLIC_ORCHESTRATOR_URL. Used to build
# absolute preview URLs. Blank = derive from APP_ENV.
PUBLIC_BASE_URL=

# Comma-separated origins allowed to call the HTTP/WS API. Blank = derive
# from APP_ENV (http://localhost:3000 locally, https://meero.im in prod).
ALLOWED_ORIGINS=
