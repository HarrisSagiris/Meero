# --- Environment (the single flag) ---
# "local" (default) runs the stack against localhost. Set to "prod" and
# `make up`/`make build` automatically layer docker-compose.prod.yml on top
# of docker-compose.yml, which bakes NEXT_PUBLIC_ORCHESTRATOR_URL as
# https://api.meero.im into the Next.js build (this one value can't be a
# runtime toggle — Next.js inlines NEXT_PUBLIC_* into the client bundle at
# BUILD time, so a real environment switch here needs a different image,
# not just a different env var at container start). The orchestrator's own
# URLs (frontend_url, allowed_origins, OAuth callbacks, etc.) are driven by
# the separate APP_ENV in orchestrator/.env — see app/config.py — set both
# together when you actually deploy.
APP_ENV=local

# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Use the "anon" key (legacy) or the newer "publishable" key — either works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meero build orchestrator (FastAPI service in orchestrator/)
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8000

# NOTE: the service-role key is NOT used by the web app and must never be
# exposed here. It belongs to the Python orchestrator (Milestone 2) only.

#Meero is created and maintained by @HarrisSagiris and other team members.